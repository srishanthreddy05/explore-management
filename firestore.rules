rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user has admin privileges
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Helper to check if user is staff or admin
    function isStaffOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'staff'
      );
    }

    // Invoices, Customers, Products, Expenses: read/write for authenticated staff/admin
    match /invoices/{document} {
      allow read, write: if isAuthenticated();
    }
    
    match /customers/{document} {
      allow read, write: if isAuthenticated();
    }
    
    match /products/{document} {
      allow read, write: if isAuthenticated();
    }
    
    match /expenses/{document} {
      allow read, write: if isAuthenticated();
    }

    // Stats: read for all authenticated users, write for authenticated users (as writes are triggered in transaction/batches)
    match /stats/{document} {
      allow read, write: if isAuthenticated();
    }

    // Administrative collections: write restricted to Admin role
    match /staff/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || !exists(/databases/$(database)/documents/staff/{document});
    }
    
    match /settings/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId || isAdmin();
    }
  }
}
